# Fecha de autuação inicial, dd/MM/yyyy. Si se omite, usa DIAS_ATRAS.
DATA_INICIO=

# Fecha de autuação final, dd/MM/yyyy. Default: hoy.
DATA_FIM=

# Si no se pasa DATA_INICIO, cuántos días atrás usar
DIAS_ATRAS=30

# Delay mínimo entre requests (ms) — cortesía con el servidor
REQUEST_DELAY_MS=1500

# Timeout por request (ms)
REQUEST_TIMEOUT_MS=30000

# Reintentos ante 429 (o bloqueo del WAF) antes de rendirse
MAX_RETRIES=5

# Backoff base (ms), exponencial con jitter
RETRY_BASE_DELAY_MS=2000

# Techo del backoff (ms)
RETRY_MAX_DELAY_MS=30000

# Límite de procesos a scrapear en una corrida. 0 = sin límite (recomendado
# setear un número chico para la primera prueba)
MAX_PROCESSOS=0
